# ========================================================
# AI Loan Eligibility Checker - Environment Configuration
# ========================================================

# --- Anthropic Claude AI Configuration ---
# Your Anthropic API Key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Claude model to use for financial reasoning
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Google Sheets Integration Configuration ---
# Google Sheet Spreadsheet ID (Found in URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Option A: Google Apps Script Webhook URL (Easiest setup - no GCP service account required)
# Deploy your Google Sheet Apps Script as a Web App and paste the execution URL here:
GOOGLE_SHEETS_WEBHOOK_URL=

# Option B: Google Cloud Service Account JSON File Path (or raw JSON string)
# Path to service account credentials JSON (e.g., ./credentials/service_account.json)
GOOGLE_SERVICE_ACCOUNT_PATH=

# Option C: Google Sheets API Key
GOOGLE_SHEETS_API_KEY=

# --- Server Configuration ---
PORT=5000
DEBUG=True
SECRET_KEY=bfsi-loan-checker-secret-key-change-in-prod
